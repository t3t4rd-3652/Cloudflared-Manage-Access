# Fins de ligne : LF partout, sauf les fichiers propres à Windows.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf

# Scripts exécutés sur des serveurs Linux : jamais de CRLF.
*.sh          text eol=lf
*.bats        text eol=lf
server/*      text eol=lf

# Binaires
*.png  binary
*.ico  binary
*.svg  text eol=lf
*.exe  binary

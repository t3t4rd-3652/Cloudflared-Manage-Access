/* CMA — base QSS de référence. Style windows11 conservé pour les sous-contrôles natifs. */
QWidget { color: #172B3A; font-family: "Segoe UI"; font-size: 10.5pt; }
QWidget#PageBody, QDialog { background-color: #F3F6F8; }
QFrame#Sidebar, QStatusBar { background-color: #E9EFF3; }
QFrame#Sidebar { border-right: 1px solid #C6D1DB; }
QFrame[role="panel"], QFrame[role="session"] {
    background-color: #FFFFFF; border: 1px solid #C6D1DB; border-radius: 8px;
}
QFrame[role="empty"] { background-color: #F3F6F8; border: none; }
QLabel[role="title"] { font-size: 20pt; font-weight: 600; }
QLabel[role="objectTitle"] { font-size: 16pt; font-weight: 600; }
QLabel[role="section"] { font-size: 11pt; font-weight: 600; }
QLabel[role="muted"] { color: #4B5D6B; }
QLabel[role="mono"], QPlainTextEdit[role="code"] {
    font-family: "Cascadia Mono"; font-size: 10pt;
}
QPushButton, QToolButton {
    color: #172B3A; background-color: #FFFFFF;
    border: 2px solid #708392; border-radius: 6px;
    padding: 6px 12px; min-height: 20px;
}
QToolButton[role="icon"] { min-width: 20px; min-height: 20px; padding: 4px; }
QPushButton:hover, QToolButton:hover { background-color: #E6EEF5; }
QPushButton:pressed, QToolButton:pressed { background-color: #D8E5F0; }
QPushButton:checked, QToolButton:checked { background-color: #E3EEFC; }
QPushButton[role="primary"] {
    color: #FFFFFF; background-color: #165DB5; border-color: #165DB5; font-weight: 600;
}
QPushButton[role="primary"]:hover { background-color: #124F9B; border-color: #124F9B; }
QPushButton[role="primary"]:pressed { background-color: #104386; border-color: #104386; }
QPushButton[role="danger"] { color: #AE2633; }
QPushButton[role="link"] { color: #165DB5; border-color: transparent; }
QPushButton:focus, QToolButton:focus { border-color: #165DB5; }
QPushButton[role="primary"]:focus { border-color: #FFFFFF; }
QFrame[role="focusShell"] { border: 2px solid transparent; border-radius: 8px; }
QFrame[role="focusShell"][focusWithin="true"] { border-color: #165DB5; }
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox {
    color: #172B3A; background-color: #FFFFFF;
    border: 2px solid #708392; border-radius: 6px;
    padding: 6px; min-height: 20px;
    selection-color: #172B3A; selection-background-color: #E3EEFC;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #165DB5;
}
QLineEdit[invalid="true"], QSpinBox[invalid="true"] { border-color: #AE2633; }
QLabel[role="error"] { color: #AE2633; }
QCheckBox, QRadioButton { spacing: 8px; min-height: 32px; }
QCheckBox:focus, QRadioButton:focus { outline: 2px solid #165DB5; }
QAbstractItemView {
    background-color: #FFFFFF; alternate-background-color: #FFFFFF;
    color: #172B3A; border: 1px solid #C6D1DB;
    selection-color: #172B3A; selection-background-color: #E3EEFC;
    gridline-color: #C6D1DB;
}
QAbstractItemView::item { min-height: 32px; padding: 2px 8px; }
QAbstractItemView::item:hover { background-color: #E6EEF5; }
QAbstractItemView::item:selected { background-color: #E3EEFC; color: #172B3A; }
QAbstractItemView::item:focus { border: 2px solid #165DB5; }
QListView#Navigation { background-color: #E9EFF3; border: none; }
QListView#Navigation::item { min-height: 36px; border-left: 3px solid transparent; }
QListView#Navigation::item:selected { border-left: 3px solid #165DB5; font-weight: 600; }
QHeaderView::section { background-color: #E9EFF3; color: #172B3A; padding: 8px; border: none; border-bottom: 1px solid #C6D1DB; }
QTabWidget::pane { border: 1px solid #C6D1DB; background-color: #FFFFFF; }
QTabBar::tab { background-color: #F3F6F8; color: #172B3A; padding: 8px 12px; border: 2px solid transparent; }
QTabBar::tab:hover { background-color: #E6EEF5; }
QTabBar::tab:selected { background-color: #FFFFFF; border-bottom-color: #165DB5; }
QTabBar:focus { border: 2px solid #165DB5; }
QSplitter::handle { background-color: #F3F6F8; }
QSplitter::handle:hover { background-color: #E6EEF5; }
QMenu { background-color: #FFFFFF; color: #172B3A; border: 1px solid #708392; padding: 4px; }
QMenu::item { padding: 8px 24px; }
QMenu::item:selected { background-color: #E3EEFC; color: #172B3A; }
QMenu::separator { height: 1px; background-color: #C6D1DB; margin: 4px 8px; }
QToolTip { background-color: #FFFFFF; color: #172B3A; border: 1px solid #708392; padding: 6px; }
QProgressBar { background-color: #E9EFF3; border: 1px solid #708392; border-radius: 4px; min-height: 8px; }
QProgressBar::chunk { background-color: #165DB5; border-radius: 3px; }
/* Le pourcentage est un QLabel séparé ; appeler setTextVisible(False). */
QLabel[role="badge"] { padding: 3px 8px; border-radius: 4px; font-size: 9.5pt; font-weight: 600; }
QLabel[role="badge"][status="success"], QFrame[role="banner"][status="success"] { background-color: #E7F4EC; color: #17633D; border: 1px solid #17633D; border-radius: 4px; }
QFrame[role="banner"][status="success"] QLabel { color: #17633D; background-color: transparent; }
QLabel[role="badge"][status="warning"], QFrame[role="banner"][status="warning"] { background-color: #FFF1D6; color: #784700; border: 1px solid #784700; border-radius: 4px; }
QFrame[role="banner"][status="warning"] QLabel { color: #784700; background-color: transparent; }
QLabel[role="badge"][status="danger"], QFrame[role="banner"][status="danger"] { background-color: #FDECEE; color: #AE2633; border: 1px solid #AE2633; border-radius: 4px; }
QFrame[role="banner"][status="danger"] QLabel { color: #AE2633; background-color: transparent; }
QLabel[role="badge"][status="info"], QFrame[role="banner"][status="info"] { background-color: #E3EEFC; color: #165DB5; border: 1px solid #165DB5; border-radius: 4px; }
QFrame[role="banner"][status="info"] QLabel { color: #165DB5; background-color: transparent; }
QLabel[role="badge"][status="neutral"], QFrame[role="banner"][status="neutral"] { background-color: #E9EFF3; color: #4B5D6B; border: 1px solid #4B5D6B; border-radius: 4px; }
QFrame[role="banner"][status="neutral"] QLabel { color: #4B5D6B; background-color: transparent; }
QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled,
QPlainTextEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QPushButton[role="primary"]:disabled, QPushButton[role="danger"]:disabled,
QPushButton[role="link"]:disabled {
    color: #526472; background-color: #E9EFF3; border-color: #708392;
}
QMenu::item:disabled, QTabBar::tab:disabled { color: #526472; background-color: #E9EFF3; }

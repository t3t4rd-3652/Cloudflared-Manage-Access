/* CMA — base QSS de référence. Style windows11 conservé pour les sous-contrôles natifs. */
QWidget { color: #F1F5F9; font-family: "Segoe UI"; font-size: 10.5pt; }
QWidget#PageBody, QDialog { background-color: #111A22; }
QFrame#Sidebar, QStatusBar { background-color: #15212B; }
QFrame#Sidebar { border-right: 1px solid #3A4D5E; }
QFrame[role="panel"], QFrame[role="session"] {
    background-color: #1B2935; border: 1px solid #3A4D5E; border-radius: 8px;
}
QFrame[role="empty"] { background-color: #111A22; border: none; }
QLabel[role="title"] { font-size: 20pt; font-weight: 600; }
QLabel[role="objectTitle"] { font-size: 16pt; font-weight: 600; }
QLabel[role="section"] { font-size: 11pt; font-weight: 600; }
QLabel[role="muted"] { color: #B6C4D2; }
QLabel[role="mono"], QPlainTextEdit[role="code"] {
    font-family: "Cascadia Mono"; font-size: 10pt;
}
QPushButton, QToolButton {
    color: #F1F5F9; background-color: #1B2935;
    border: 2px solid #8499AB; border-radius: 6px;
    padding: 6px 12px; min-height: 20px;
}
QToolButton[role="icon"] { min-width: 20px; min-height: 20px; padding: 4px; }
QPushButton:hover, QToolButton:hover { background-color: #263B4C; }
QPushButton:pressed, QToolButton:pressed { background-color: #30495E; }
QPushButton:checked, QToolButton:checked { background-color: #223F5B; }
QPushButton[role="primary"] {
    color: #111A22; background-color: #80B8FF; border-color: #80B8FF; font-weight: 600;
}
QPushButton[role="primary"]:hover { background-color: #A2CCFF; border-color: #A2CCFF; }
QPushButton[role="primary"]:pressed { background-color: #6BA6F0; border-color: #6BA6F0; }
QPushButton[role="danger"] { color: #FFABB2; }
QPushButton[role="link"] { color: #80B8FF; border-color: transparent; }
QPushButton:focus, QToolButton:focus { border-color: #80B8FF; }
QPushButton[role="primary"]:focus { border-color: #111A22; }
QFrame[role="focusShell"] { border: 2px solid transparent; border-radius: 8px; }
QFrame[role="focusShell"][focusWithin="true"] { border-color: #80B8FF; }
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox {
    color: #F1F5F9; background-color: #1B2935;
    border: 2px solid #8499AB; border-radius: 6px;
    padding: 6px; min-height: 20px;
    selection-color: #F1F5F9; selection-background-color: #223F5B;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #80B8FF;
}
QLineEdit[invalid="true"], QSpinBox[invalid="true"] { border-color: #FFABB2; }
QLabel[role="error"] { color: #FFABB2; }
QCheckBox, QRadioButton { spacing: 8px; min-height: 32px; }
QCheckBox:focus, QRadioButton:focus { outline: 2px solid #80B8FF; }
QAbstractItemView {
    background-color: #1B2935; alternate-background-color: #1B2935;
    color: #F1F5F9; border: 1px solid #3A4D5E;
    selection-color: #F1F5F9; selection-background-color: #223F5B;
    gridline-color: #3A4D5E;
}
QAbstractItemView::item { min-height: 32px; padding: 2px 8px; }
QAbstractItemView::item:hover { background-color: #263B4C; }
QAbstractItemView::item:selected { background-color: #223F5B; color: #F1F5F9; }
QAbstractItemView::item:focus { border: 2px solid #80B8FF; }
QListView#Navigation { background-color: #15212B; border: none; }
QListView#Navigation::item { min-height: 36px; border-left: 3px solid transparent; }
QListView#Navigation::item:selected { border-left: 3px solid #80B8FF; font-weight: 600; }
QHeaderView::section { background-color: #15212B; color: #F1F5F9; padding: 8px; border: none; border-bottom: 1px solid #3A4D5E; }
QTabWidget::pane { border: 1px solid #3A4D5E; background-color: #1B2935; }
QTabBar::tab { background-color: #111A22; color: #F1F5F9; padding: 8px 12px; border: 2px solid transparent; }
QTabBar::tab:hover { background-color: #263B4C; }
QTabBar::tab:selected { background-color: #1B2935; border-bottom-color: #80B8FF; }
QTabBar:focus { border: 2px solid #80B8FF; }
QSplitter::handle { background-color: #111A22; }
QSplitter::handle:hover { background-color: #263B4C; }
QMenu { background-color: #1B2935; color: #F1F5F9; border: 1px solid #8499AB; padding: 4px; }
QMenu::item { padding: 8px 24px; }
QMenu::item:selected { background-color: #223F5B; color: #F1F5F9; }
QMenu::separator { height: 1px; background-color: #3A4D5E; margin: 4px 8px; }
QToolTip { background-color: #1B2935; color: #F1F5F9; border: 1px solid #8499AB; padding: 6px; }
QProgressBar { background-color: #15212B; border: 1px solid #8499AB; border-radius: 4px; min-height: 8px; }
QProgressBar::chunk { background-color: #80B8FF; border-radius: 3px; }
/* Le pourcentage est un QLabel séparé ; appeler setTextVisible(False). */
QLabel[role="badge"] { padding: 3px 8px; border-radius: 4px; font-size: 9.5pt; font-weight: 600; }
QLabel[role="badge"][status="success"], QFrame[role="banner"][status="success"] { background-color: #173C2C; color: #87D7AC; border: 1px solid #87D7AC; border-radius: 4px; }
QFrame[role="banner"][status="success"] QLabel { color: #87D7AC; background-color: transparent; }
QLabel[role="badge"][status="warning"], QFrame[role="banner"][status="warning"] { background-color: #493419; color: #FFD28A; border: 1px solid #FFD28A; border-radius: 4px; }
QFrame[role="banner"][status="warning"] QLabel { color: #FFD28A; background-color: transparent; }
QLabel[role="badge"][status="danger"], QFrame[role="banner"][status="danger"] { background-color: #4A242B; color: #FFABB2; border: 1px solid #FFABB2; border-radius: 4px; }
QFrame[role="banner"][status="danger"] QLabel { color: #FFABB2; background-color: transparent; }
QLabel[role="badge"][status="info"], QFrame[role="banner"][status="info"] { background-color: #223F5B; color: #80B8FF; border: 1px solid #80B8FF; border-radius: 4px; }
QFrame[role="banner"][status="info"] QLabel { color: #80B8FF; background-color: transparent; }
QLabel[role="badge"][status="neutral"], QFrame[role="banner"][status="neutral"] { background-color: #15212B; color: #B6C4D2; border: 1px solid #B6C4D2; border-radius: 4px; }
QFrame[role="banner"][status="neutral"] QLabel { color: #B6C4D2; background-color: transparent; }
QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled,
QPlainTextEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QPushButton[role="primary"]:disabled, QPushButton[role="danger"]:disabled,
QPushButton[role="link"]:disabled {
    color: #9BACBB; background-color: #263541; border-color: #8499AB;
}
QMenu::item:disabled, QTabBar::tab:disabled { color: #9BACBB; background-color: #263541; }
